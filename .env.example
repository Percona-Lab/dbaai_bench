# Copy to .env and fill in the key for whichever provider you use.
#
# A value already exported in the real environment beats this file.
#
# --- OpenRouter --------------------------------------------------------------
# What dba.py uses by default. Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- DigitalOcean Serverless Inference ---------------------------------------
# What dba.py uses with --provider do. Create a model access key in the
# DigitalOcean control panel:
#   Gradient AI Platform -> Serverless Inference -> Model access keys
# A DigitalOcean personal access token also works.
DIGITALOCEAN_INFERENCE_KEY=

# --- A server you run yourself -----------------------------------------------
# What dba.py uses with --provider local: any OpenAI-compatible server (LM
# Studio, vLLM, llama.cpp, Ollama). Nothing to fill in - it needs no key, and it
# defaults to the Mac Studio at https://mac-studio-lm.int.percona.com. Name the
# model with -m: whatever is loaded on the box is what there is, so nothing can
# be pinned here. Set DBA_SELFHOSTED_KEY only if the server sits behind auth.

# Optional overrides
# DBA_PROVIDER=digitalocean        # default provider for dba.py
# DO_DBA_MODEL=                    # model for dba.py, whatever the provider
# DBA_RUNS_DIR=                    # where runs go (default: this directory)
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
# DBA_SELFHOSTED_BASE_URL=http://127.0.0.1:1234   # a laptop running LM Studio
# DBA_SELFHOSTED_MODEL=            # model for --provider local
# DBA_SELFHOSTED_KEY=              # only if your own server wants one
# DO_INFERENCE_TIMEOUT=180         # seconds to wait for the next streamed byte
#                                  # (a self-hosted server gets 900 by default,
#                                  #  because the first request loads the weights)
